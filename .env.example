# Google Apps Script web app URL for email collection
# See docs/google-sheets-setup.md for setup instructions
GOOGLE_SCRIPT_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec

# OneMap API — geocoding for distance-based BTO proximity detection
# Register free at https://www.onemap.gov.sg/apidocs/register
# Optional: falls back to block-number heuristic if not configured
ONEMAP_EMAIL=
ONEMAP_PASSWORD=

# data.gov.sg API key — higher rate limits (20 req/10s vs 4)
# Register at https://guide.data.gov.sg/developer-guide/api-overview/how-to-use-your-api-key
# Optional: works without key but rate-limited to 4 req/10s
DATA_GOV_SG_API_KEY=
